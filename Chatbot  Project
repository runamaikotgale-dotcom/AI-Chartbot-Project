import requests

API_KEY = "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"   # 🔑 Replace with your API key
URL = "https://openrouter.ai/api/v1/chat/completions"

headers = {
    "Authorization": f"Bearer {API_KEY}",
    "Content-Type": "application/json"
}

def chat_with_bot(user_input):
    data = {
        "model": "deepseek/deepseek-chat",   # you can change model
        "messages": [
            {"role": "user", "content": user_input}
        ]
    }

    response = requests.post(URL, headers=headers, json=data)

    if response.status_code == 200:
        result = response.json()
        return result['choices'][0]['message']['content']
    else:
        return f"Error: {response.status_code}, {response.text}"


# 🔹 Chat loop
print("Chatbot started (type 'exit' to stop)\n")

while True:
    user_input = input("You: ")
    
    if user_input.lower() == "exit":
        print("Chatbot stopped.")
        break

    reply = chat_with_bot(user_input)
    print("Bot:", reply)